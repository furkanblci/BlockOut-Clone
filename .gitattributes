# Satır sonlarını otomatik normalize et (Windows/Mac/Linux uyumu)
* text=auto

# Unity'nin YAML tabanlı dosyaları — metin olarak sakla, diff alınabilsin
*.cs text diff=csharp
*.meta text
*.unity text
*.prefab text
*.asset text
*.mat text
*.anim text
*.controller text
*.physicMaterial text
*.physicsMaterial2D text

# Binary dosyalar — Git bunları diff'lemeye çalışmasın
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.psd binary
*.tga binary
*.fbx binary
*.obj binary
*.blend binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.a binary
